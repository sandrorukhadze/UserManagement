using eMembership.Application.Abstractions;
using Microsoft.AspNetCore.Mvc;

namespace eMembership.Api.Controllers;

[ApiController]
[Route("api/users")]
public sealed class UserAppointmentsController
    : ControllerBase
{
    private readonly IUserAppointmentRepository _repository;

    public UserAppointmentsController(
        IUserAppointmentRepository repository)
    {
        _repository = repository;
    }

    [HttpGet("{userId:guid}/appointments")]
    public async Task<IActionResult> GetAppointments(
        Guid userId,
        CancellationToken cancellationToken)
    {
        var result =
            await _repository.GetByUserIdAsync(
                userId,
                cancellationToken);

        return Ok(result);
    }
}


