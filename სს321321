# 9. Main Documents Page

შექმენი:

```text
src/pages/DocumentsPage.tsx
```

კოდი:

```tsx
import { useState } from "react";

import UserSelect from "../components/UserSelect";

import DocumentsTable from "../components/DocumentsTable";

import { users } from "../data/users";

import {
  getUserDocuments
} from "../api/documentsApi";

import type {
  DocumentItem
} from "../types/DocumentItem";

export default function DocumentsPage() {

  // არჩეული User ID
  const [
    selectedUserId,
    setSelectedUserId
  ] = useState("");

  // Backend-იდან დაბრუნებული Documents
  const [
    documents,
    setDocuments
  ] = useState<DocumentItem[]>([]);

  // Loading state
  const [
    loading,
    setLoading
  ] = useState(false);

  // Error
  const [
    error,
    setError
  ] = useState("");

  // ==========================================================
  // User dropdown-ის ცვლილება
  // ==========================================================

  const handleUserChange =
    async (userId: string) => {

      setSelectedUserId(userId);

      setDocuments([]);

      setError("");

      // თუ არაფერი არჩეულა
      if (!userId) {
        return;
      }

      try {

        setLoading(true);

        // Backend call
        const data =
          await getUserDocuments(
            userId
          );

        // Documents state
        setDocuments(data);

      }
      catch (error) {

        console.error(error);

        setError(
          "დოკუმენტების წამოღება ვერ მოხერხდა."
        );

      }
      finally {

        setLoading(false);

      }
    };

  return (

    <div className="container">

      <div className="header">

        <h1>
          დოკუმენტები
        </h1>

        <p>
          აირჩიე მომხმარებელი და ნახე მისი დოკუმენტები
        </p>

      </div>

      <div className="card">

        <UserSelect
          users={users}
          value={selectedUserId}
          onChange={handleUserChange}
        />

      </div>

      {loading && (

        <div className="message">
          იტვირთება...
        </div>

      )}

      {error && (

        <div className="error">
          {error}
        </div>

      )}

      {!loading &&
        !error &&
        selectedUserId &&
        documents.length === 0 && (

          <div className="message">

            ამ მომხმარებლისთვის
            დოკუმენტები ვერ მოიძებნა.

          </div>

        )}

      {documents.length > 0 && (

        <div className="documents-section">

          <div className="documents-header">

            <h2>
              დოკუმენტები
            </h2>

            <span>
              რაოდენობა: {documents.length}
            </span>

          </div>

          <DocumentsTable
            documents={documents}
          />

        </div>

      )}

    </div>
  );
}
```

