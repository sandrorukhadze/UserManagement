```

კოდი:

```ts
import type { DocumentItem } from "../types/DocumentItem";

const API_URL = "http://localhost:5273";

export async function getUserDocuments(
  userId: string
): Promise<DocumentItem[]> {

  const response = await fetch(
    `${API_URL}/api/documents/user/${userId}`
  );

  if (!response.ok) {
    throw new Error(
      `Backend Error: ${response.status}`
    );
  }

  const data: DocumentItem[] =
    await response.json();

  return data;
}
```

