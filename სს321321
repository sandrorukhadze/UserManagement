using eMembership.Domain.Entities;
using Microsoft.EntityFrameworkCore;

namespace eMembership.Infrastructure.Persistence;

/// <summary>
/// eMembership SQL Server database context.
/// </summary>
public sealed class MembershipDbContext : DbContext
{
    public MembershipDbContext(
        DbContextOptions<MembershipDbContext> options)
        : base(options)
    {
    }

    public DbSet<User> Users => Set<User>();

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        base.OnModelCreating(modelBuilder);

        ConfigureUsers(modelBuilder);
    }

    private static void ConfigureUsers(ModelBuilder modelBuilder)
    {
        var entity = modelBuilder.Entity<User>();

        // SQL table:
        //
        // [eMembership].[users].[Users]
        //
        // Database-ს connection string განსაზღვრავს,
        // ამიტომ აქ მხოლოდ schema/table გვჭირდება.
        entity.ToTable(
            name: "Users",
            schema: "users");

        entity.HasKey(x => x.ID);

        entity.Property(x => x.ID)
            .HasColumnName("ID");

        entity.Property(x => x.UserName)
            .HasColumnName("UserName");

        entity.Property(x => x.Password)
            .HasColumnName("Password");

        entity.Property(x => x.FullName)
            .HasColumnName("FullName");

        entity.Property(x => x.Gender)
            .HasColumnName("Gender");

        entity.Property(x => x.PrivateNumber)
            .HasColumnName("PrivateNumber");

        entity.Property(x => x.EMail)
            .HasColumnName("EMail");

        entity.Property(x => x.IsActive)
            .HasColumnName("IsActive");

        entity.Property(x => x.CreateDate)
            .HasColumnName("CreateDate");

        entity.Property(x => x.CreatedBy)
            .HasColumnName("CreatedBy");

        entity.Property(x => x.LastModifyDate)
            .HasColumnName("LastModifyDate");

        entity.Property(x => x.LastModifiedBy)
            .HasColumnName("LastModifiedBy");

        entity.Property(x => x.Version)
            .HasColumnName("Version")
            .IsRowVersion();

        entity.Property(x => x.IsFirstPassword)
            .HasColumnName("IsFirstPassword");

        entity.Property(x => x.IsChancelleryAccount)
            .HasColumnName("IsChancelleryAccount");
    }
}
