              </td>

              <td>
                {doc.isSentText ?? "-"}
              </td>

              <td>
                {doc.isReadText ?? "-"}
              </td>

              <td>
                {formatDate(
                  doc.createDate
                )}
              </td>

              <td>
                {formatDate(
                  doc.registrationDate
                )}
              </td>

              <td>
                {doc.hasAttachmentText ?? "-"}
              </td>

            </tr>

          ))}

        </tbody>

      </table>

    </div>
  );
}

function formatDate(
  value?: string | null
) {

  if (!value) {
    return "-";
  }

  return new Date(value)
    .toLocaleString("ka-GE");
}
