# 17. Program.cs

## src/eMembership.Api/Program.cs

```csharp
using System.Text;
using eMembership.Application.Abstractions;
using eMembership.Application.Auth;
using eMembership.Infrastructure.Authentication;
using eMembership.Infrastructure.Persistence;
using eMembership.Infrastructure.Repositories;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.EntityFrameworkCore;
using Microsoft.IdentityModel.Tokens;

var builder = WebApplication.CreateBuilder(args);

//
// Controllers
//
builder.Services.AddControllers();

//
// Swagger
//
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();

//
// ==========================================================
// DATABASE
// ==========================================================
//

var membershipConnectionString =
    builder.Configuration.GetConnectionString("Membership")
    ?? throw new InvalidOperationException(
        "Connection string 'Membership' was not found.");

builder.Services.AddDbContext<MembershipDbContext>(
    options =>
    {
        options.UseSqlServer(
            membershipConnectionString);
    });

//
// ==========================================================
// DEPENDENCY INJECTION
// ==========================================================
//

// Repository
builder.Services.AddScoped<
    IUserRepository,
    UserRepository>();

// Legacy MD5 verification
builder.Services.AddScoped<
    IPasswordVerifier,
    LegacyMd5PasswordVerifier>();

// JWT generator
builder.Services.AddScoped<
    IJwtTokenService,
    JwtTokenService>();

// Application service
builder.Services.AddScoped<LoginService>();

//
// ==========================================================
// JWT AUTHENTICATION
// ==========================================================
//

var jwtKey = builder.Configuration["Jwt:Key"]
    ?? throw new InvalidOperationException(
        "Jwt:Key is not configured.");

var jwtIssuer = builder.Configuration["Jwt:Issuer"]
    ?? throw new InvalidOperationException(
        "Jwt:Issuer is not configured.");

var jwtAudience = builder.Configuration["Jwt:Audience"]
    ?? throw new InvalidOperationException(
        "Jwt:Audience is not configured.");

builder.Services
    .AddAuthentication(
        JwtBearerDefaults.AuthenticationScheme)
    .AddJwtBearer(options =>
    {
        options.TokenValidationParameters =
            new TokenValidationParameters
            {
                // ვინ შექმნა token
                ValidateIssuer = true,

                // ვისთვისაა token
                ValidateAudience = true,

                // ვადა ხომ არ გაუვიდა
                ValidateLifetime = true,

                // signature სწორია თუ არა
                ValidateIssuerSigningKey = true,

                ValidIssuer = jwtIssuer,

                ValidAudience = jwtAudience,

                IssuerSigningKey =
                    new SymmetricSecurityKey(
                        Encoding.UTF8.GetBytes(jwtKey)),

                // Default 5 წუთია.
                // აქ ზუსტად expiration გვინდა.
                ClockSkew = TimeSpan.Zero
            };
    });

builder.Services.AddAuthorization();

var app = builder.Build();

//
// ==========================================================
// HTTP PIPELINE
// ==========================================================
//

if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI();
}

app.UseHttpsRedirection();

//
// ძალიან მნიშვნელოვანია რიგითობა:
//
// Authentication ჯერ
// Authorization შემდეგ
//
app.UseAuthentication();
app.UseAuthorization();

app.MapControllers();

app.Run();
```

