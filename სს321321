public Task<UserInfoDto?> GetByUserNameAsync(
    string userName,
    CancellationToken cancellationToken = default)
{
    return _users.GetByUserNameAsync(
        userName.Trim(),
        cancellationToken);
}


// ======================================================
// 4. API/Controllers/UsersController.cs
// დაამატე კლასის შიგნით, ან ჩაანაცვლე არსებული იგივე მეთოდი.
// ======================================================

[HttpGet("by-username")]
public async Task<ActionResult<UserInfoDto>> GetByUserName(
    [FromQuery] string? userName,
    CancellationToken cancellationToken)
{
    // სახელი აუცილებელია.
    if (string.IsNullOrWhiteSpace(userName))
        return BadRequest("userName აუცილებელია.");

    var user = await _userService.GetByUserNameAsync(
        userName,
        cancellationToken);

    if (user is null)
        return NotFound("მომხმარებელი ვერ მოიძებნა.");

    return Ok(user);
}


