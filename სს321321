using System.Data;
using Dapper;
using eMembership.Application.Abstractions;
using eMembership.Application.Appointments;
using eMembership.Infrastructure.Persistence;
using Microsoft.EntityFrameworkCore;

namespace eMembership.Infrastructure.Repositories;

public sealed class UserAppointmentRepository
    : IUserAppointmentRepository
{
    private readonly MembershipDbContext _dbContext;

    public UserAppointmentRepository(
        MembershipDbContext dbContext)
    {
        _dbContext = dbContext;
    }

    public async Task<IReadOnlyList<UserAppointmentDto>> GetByUserIdAsync(
        Guid userId,
        CancellationToken cancellationToken = default)
    {
        var connection =
            _dbContext.Database.GetDbConnection();

        var command = new CommandDefinition(
            commandText: "dbo.GetUserAppointments",
            parameters: new
            {
                UserID = userId
            },
            commandType: CommandType.StoredProcedure,
            cancellationToken: cancellationToken);

        var result =
            await connection.QueryAsync<UserAppointmentDto>(
                command);

        return result.ToList();
    }
}


