// ======================================================
// 2. Infrastructure/Repositories/UserRepository.cs
// დაამატე კლასის შიგნით.
// თუ ეს მეთოდი უკვე გაქვს, ჩაანაცვლე ამ ვერსიით.
// ======================================================

public async Task<UserInfoDto?> GetByUserNameAsync(
    string userName,
    CancellationToken cancellationToken = default)
{
    // ვუკავშირდებით იმავე ბაზას.
    await using var connection =
        new SqlConnection(_connectionString);

    await connection.OpenAsync(cancellationToken);

    // ვეძებთ UserName-ის ზუსტ დამთხვევას.
    const string sql = """
        SELECT TOP (1)
            ID AS UserId,
            UserName,
            FullName,
            Gender,
            PrivateNumber,
            EMail,
            IsActive
        FROM [users].[Users]
        WHERE UserName = @UserName
        ORDER BY ID;
        """;

    // ფრონტიდან მიღებული სახელი გადაეცემა SQL პარამეტრად.
    var command = new CommandDefinition(
        commandText: sql,
        parameters: new { UserName = userName },
        commandType: CommandType.Text,
        cancellationToken: cancellationToken);

    // თუ მომხმარებელი არ არსებობს, დაბრუნდება null.
    return await connection
        .QuerySingleOrDefaultAsync<UserInfoDto>(command);
}


