using System.Security.Cryptography;
using System.Text;

var password = "REAL_PASSWORD";

var utf8Hash = Convert
    .ToHexString(
        MD5.HashData(
            Encoding.UTF8.GetBytes(password)))
    .ToLowerInvariant();

var unicodeHash = Convert
    .ToHexString(
        MD5.HashData(
            Encoding.Unicode.GetBytes(password)))
    .ToLowerInvariant();

var asciiHash = Convert
    .ToHexString(
        MD5.HashData(
            Encoding.ASCII.GetBytes(password)))
    .ToLowerInvariant();

Console.WriteLine($"UTF8:    {utf8Hash}");
Console.WriteLine($"Unicode: {unicodeHash}");
Console.WriteLine($"ASCII:   {asciiHash}");
```

