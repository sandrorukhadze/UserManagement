USE [eDocument];
GO

DECLARE @appoID UNIQUEIDENTIFIER =
    'D2B5BAF3-C122-486F-9974-E26B4533B237';

DECLARE @DepID UNIQUEIDENTIFIER =
    'C46E484A-5258-4226-B981-0AF22B7D0D2B';

DECLARE @TypeID INT = 0;

SELECT TOP (100)
    ISNULL(d.DocumentNumber, '') AS [ნომერი],

    dbo.getdoctype(
        d.DocumentTypeID,
        dd.DetailTypeID,
        d.RequestType,
        dd.InnerType,
        dd.LetterType,
        d.IsTechReport,
        d.IsAutoCrim,
        bd.IsAutoCrim,
        d.InnerSubTypeID
    ) AS [ტიპი],

    dbo.Fn_GetClientByDocumentID_Alex(d.ID) AS [კლიენტი],

    ISNULL(
        dbo.Fn_GetUserFullNameByAppointmentID_Alex(d.AuthorID),
        dbo.Fn_GetUserFullNameByAppointmentID_Alex(dd.FromID)
    ) AS [ავტორი],

    ISNULL(bd.DocumentNumber, '') AS [საფუძველი],

    dd.Content AS [შინაარსი]

FROM dbo.udf_ActiveDocuments_All2fortest(
    @appoID,
    @DepID,
    @TypeID
) AS d

LEFT JOIN dbo.UDF_vw_DocumentDetailsLight() AS dd
    ON dd.ID = d.ID

LEFT JOIN dbo.UDF_vw_DocumentsWithDetails() AS bd
    ON bd.ID = d.BaseID

ORDER BY d.CreateDate DESC, d.ID;
