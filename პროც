USE [eDocument];
GO

DECLARE @UserID UNIQUEIDENTIFIER =
    '77CBA770-018B-4684-808B-EF3409385ED4';

SELECT TOP (100)
    d.DocumentNumber AS [ნომერი],
    d.DocumentTypeID AS [ტიპი],
    cid.ClientID AS [კლიენტი],
    creator.FullName AS [ავტორი],
    baseDoc.DocumentNumber AS [საფუძველი],
    dd.Contents AS [შინაარსი],

    d.CreateDate AS [შექმნის თარიღი],
    received.RegistrationDate AS [მიღების თარიღი],
    sender.FullName AS [გამომგზავნი],

    CASE received.IsReaded
        WHEN 1 THEN N'კი'
        WHEN 0 THEN N'არა'
        ELSE N'უცნობია'
    END AS [წაკითხულია],

    CASE
        WHEN EXISTS (
            SELECT 1
            FROM dbo.DocumentElVersions AS ev
            WHERE ev.DocumentID = d.ID
                AND ev.IsActive = 1
        )
        THEN N'კი'
        ELSE N'არა'
    END AS [აქვს დანართი]

FROM dbo.Documents AS d

-- ნინოს მიმდინარე დანიშვნებზე ბოლო აქტიური,
-- გაუუქმებელი შემოსული მოძრაობა
CROSS APPLY (
    SELECT TOP (1)
        m.RegistrationDate,
        m.FromID,
        m.IsReaded
    FROM dbo.Movements AS m

    INNER JOIN eMembership.orgs.UserAppointments AS ua
        ON ua.ID = m.ToID

    WHERE m.ThingID = d.ID
        AND ua.UserID = @UserID
        AND ua.IsActive = 1
        AND ua.BeginDate <= CONVERT(date, GETDATE())
        AND (
            ua.FinishDate IS NULL
            OR ua.FinishDate >= CONVERT(date, GETDATE())
        )
        AND m.IsActive = 1
        AND m.Canceled = 0

    ORDER BY
        m.CreateDate DESC,
        m.ID DESC
) AS received

LEFT JOIN dbo.DocumentDetails AS dd
    ON dd.ID = d.ID

LEFT JOIN dbo.Documents AS baseDoc
    ON baseDoc.ID = d.BaseDocumentID

-- დოკუმენტის შემქმნელი
LEFT JOIN eMembership.users.Users AS creator
    ON creator.ID = d.CreatedBy

-- დოკუმენტის კლიენტები
LEFT JOIN dbo.ClientsInDocuments AS cid
    ON cid.DocumentID = d.ID
    AND cid.IsActive = 1

-- გამომგზავნის დანიშვნა
LEFT JOIN eMembership.orgs.UserAppointments AS senderAppointment
    ON senderAppointment.ID = received.FromID

-- გამომგზავნის სახელი
LEFT JOIN eMembership.users.Users AS sender
    ON sender.ID = senderAppointment.UserID

WHERE d.IsActive = 1

ORDER BY d.CreateDate DESC, d.ID;
