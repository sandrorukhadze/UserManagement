USE [eDocument];
GO

DECLARE @UserID UNIQUEIDENTIFIER =
    '77CBA770-018B-4684-808B-EF3409385ED4';

SELECT TOP (100)
    d.DocumentNumber AS [ნომერი],

    dbo.getdoctype(
        d.DocumentTypeID,
        dd.DetailTypeID,
        d.RequestType,
        dd.InnerType,
        dd.LetterType,
        d.IsTechReport,
        d.IsAutoCrim,
        bd.IsAutoCrim,
        d.InnerSubTypeID
    ) AS [ტიპი],

    CAST(NULL AS nvarchar(500)) AS [კლიენტი],

    ISNULL(
        dbo.Fn_GetUserFullNameByAppointmentID_Alex(d.AuthorID),
        dbo.Fn_GetUserFullNameByAppointmentID_Alex(dd.FromID)
    ) AS [ავტორი],

    bd.DocumentNumber AS [საფუძველი],

    dd.Content AS [შინაარსი]

FROM eMembership.orgs.UserAppointments AS ua

INNER JOIN eMembership.orgs.Positions AS p
    ON p.ID = ua.PositionID

CROSS APPLY dbo.udf_ActiveDocuments_All2fortest(
    ua.ID,
    p.OrganizationStructureID,
    0
) AS d

LEFT JOIN dbo.UDF_vw_DocumentDetailsLight() AS dd
    ON dd.ID = d.ID

LEFT JOIN dbo.UDF_vw_DocumentsWithDetails() AS bd
    ON bd.ID = d.BaseID

WHERE ua.UserID = @UserID
    AND ua.IsActive = 1
    AND ua.BeginDate <= CONVERT(date, GETDATE())
    AND (
        ua.FinishDate IS NULL
        OR ua.FinishDate >= CONVERT(date, GETDATE())
    )

ORDER BY d.CreateDate DESC, d.ID;
