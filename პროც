SELECT
    [ID],
    '[' + [UserName] + ']' AS UserNameVisible,
    [Password],
    [PrivateNumber],
    LEN([UserName]) AS UserNameLength,
    DATALENGTH([UserName]) AS UserNameBytes
FROM [eMembership].[users].[Users]
WHERE [UserName] = N'ნინო კიკაბიძე';

SELECT
    COLUMN_NAME,
    DATA_TYPE,
    CHARACTER_MAXIMUM_LENGTH
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'users'
  AND TABLE_NAME = 'Users'
  AND COLUMN_NAME IN ('UserName', 'Password');


using System.Security.Cryptography;
using System.Text;
using eMembership.Application.Abstractions;

namespace eMembership.Infrastructure.Authentication;

public sealed class LegacyMd5PasswordVerifier : IPasswordVerifier
{
    public bool Verify(
        string plainPassword,
        string userName,
        string passwordHash)
    {
        var dbHash = passwordHash.Trim();

        var values = new Dictionary<string, string>
        {
            // როგორც შენ თქვი
            ["password + username"] =
                plainPassword + userName,

            // reverse order
            ["username + password"] =
                userName + plainPassword,

            // Trim
            ["password + username.Trim"] =
                plainPassword + userName.Trim(),

            ["username.Trim + password"] =
                userName.Trim() + plainPassword,

            // lowercase
            ["password + username.lower"] =
                plainPassword + userName.Trim().ToLowerInvariant(),

            // uppercase
            ["password + username.upper"] =
                plainPassword + userName.Trim().ToUpperInvariant(),

            // ორივეს trim
            ["password.Trim + username.Trim"] =
                plainPassword.Trim() + userName.Trim(),

            // separator-იანი ვარიანტები
            ["password:username"] =
                plainPassword + ":" + userName.Trim(),

            ["username:password"] =
                userName.Trim() + ":" + plainPassword
        };

        var encodings = new Dictionary<string, Encoding>
        {
            ["UTF8"] = Encoding.UTF8,
            ["UTF16-LE"] = Encoding.Unicode,
            ["UTF16-BE"] = Encoding.BigEndianUnicode,
            ["ASCII"] = Encoding.ASCII,
            ["UTF32"] = Encoding.UTF32
        };

        Console.WriteLine();
        Console.WriteLine("==========================================");
        Console.WriteLine($"USER    : [{userName}]");
        Console.WriteLine($"LENGTH  : {userName.Length}");
        Console.WriteLine($"DB HASH : {dbHash}");
        Console.WriteLine("==========================================");

        foreach (var value in values)
        {
            foreach (var encoding in encodings)
            {
                var calculatedHash = CreateHash(
                    value.Value,
                    encoding.Value);

                Console.WriteLine(
                    $"{value.Key} / {encoding.Key}");
                Console.WriteLine(
                    $"    {calculatedHash}");

                if (string.Equals(
                        calculatedHash,
                        dbHash,
                        StringComparison.OrdinalIgnoreCase))
                {
                    Console.WriteLine();
                    Console.WriteLine("******** MATCH FOUND ********");
                    Console.WriteLine($"VALUE    = {value.Key}");
                    Console.WriteLine($"ENCODING = {encoding.Key}");
                    Console.WriteLine("*****************************");

                    return true;
                }
            }
        }

        Console.WriteLine();
        Console.WriteLine("NO MATCH FOUND");
        Console.WriteLine("==========================================");

        return false;
    }

    private static string CreateHash(
        string value,
        Encoding encoding)
    {
        var bytes = encoding.GetBytes(value);

        var hashBytes = MD5.HashData(bytes);

        return Convert
            .ToHexString(hashBytes)
            .ToLowerInvariant();
    }
}
