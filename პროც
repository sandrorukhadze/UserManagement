using System.Security.Cryptography;
using System.Text;
using eMembership.Application.Abstractions;

namespace eMembership.Infrastructure.Authentication;

public sealed class LegacyMd5PasswordVerifier : IPasswordVerifier
{
    public bool Verify(
        string plainPassword,
        string userName,
        string passwordHash)
    {
        var valueToHash = plainPassword + userName;

        var utf8 = CreateHash(
            valueToHash,
            Encoding.UTF8);

        var unicode = CreateHash(
            valueToHash,
            Encoding.Unicode);

        var bigEndianUnicode = CreateHash(
            valueToHash,
            Encoding.BigEndianUnicode);

        Console.WriteLine("--------------------------------");
        Console.WriteLine($"UserName       : {userName}");
        Console.WriteLine($"DB Hash        : {passwordHash}");
        Console.WriteLine($"UTF8           : {utf8}");
        Console.WriteLine($"Unicode UTF16LE: {unicode}");
        Console.WriteLine($"Unicode UTF16BE: {bigEndianUnicode}");
        Console.WriteLine("--------------------------------");

        if (string.Equals(
                utf8,
                passwordHash.Trim(),
                StringComparison.OrdinalIgnoreCase))
        {
            Console.WriteLine("MATCH = UTF8");
            return true;
        }

        if (string.Equals(
                unicode,
                passwordHash.Trim(),
                StringComparison.OrdinalIgnoreCase))
        {
            Console.WriteLine("MATCH = Unicode UTF16LE");
            return true;
        }

        if (string.Equals(
                bigEndianUnicode,
                passwordHash.Trim(),
                StringComparison.OrdinalIgnoreCase))
        {
            Console.WriteLine("MATCH = Unicode UTF16BE");
            return true;
        }

        Console.WriteLine("NO MATCH");

        return false;
    }

    private static string CreateHash(
        string value,
        Encoding encoding)
    {
        var bytes = encoding.GetBytes(value);

        var hashBytes = MD5.HashData(bytes);

        return Convert
            .ToHexString(hashBytes)
            .ToLowerInvariant();
    }
}
