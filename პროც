using System.Security.Cryptography;
using System.Text;
using eMembership.Application.Abstractions;

namespace eMembership.Infrastructure.Authentication;

public sealed class LegacyMd5PasswordVerifier : IPasswordVerifier
{
    public bool Verify(
        string plainPassword,
        string userName,
        string passwordHash)
    {
        var valueToHash = plainPassword + userName;
        var dbHash = passwordHash.Trim();

        var variants = new Dictionary<string, string>
        {
            ["UTF8"] = CreateHash(
                valueToHash,
                Encoding.UTF8),

            ["Unicode UTF16LE"] = CreateHash(
                valueToHash,
                Encoding.Unicode),

            ["Unicode UTF16BE"] = CreateHash(
                valueToHash,
                Encoding.BigEndianUnicode),

            ["ASCII"] = CreateHash(
                valueToHash,
                Encoding.ASCII),

            ["UTF32"] = CreateHash(
                valueToHash,
                Encoding.UTF32)
        };

        Console.WriteLine("--------------------------------");
        Console.WriteLine($"UserName : {userName}");
        Console.WriteLine($"DB Hash  : {dbHash}");
        Console.WriteLine();

        foreach (var item in variants)
        {
            Console.WriteLine(
                $"{item.Key,-18}: {item.Value}");

            if (string.Equals(
                    item.Value,
                    dbHash,
                    StringComparison.OrdinalIgnoreCase))
            {
                Console.WriteLine();
                Console.WriteLine($"MATCH = {item.Key}");
                Console.WriteLine("--------------------------------");

                return true;
            }
        }

        Console.WriteLine();
        Console.WriteLine("NO MATCH");
        Console.WriteLine("--------------------------------");

        return false;
    }

    private static string CreateHash(
        string value,
        Encoding encoding)
    {
        var bytes = encoding.GetBytes(value);

        var hashBytes = MD5.HashData(bytes);

        return Convert
            .ToHexString(hashBytes)
            .ToLowerInvariant();
    }
}
