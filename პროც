# 5. DocumentRepository

შექმენი:

```text
src/eMembership.Infrastructure/Repositories/DocumentRepository.cs
```

კოდი:

```csharp
using System.Data;
using eMembership.Application.Abstractions;
using eMembership.Application.Documents;
using eMembership.Infrastructure.Persistence;
using Microsoft.EntityFrameworkCore;

namespace eMembership.Infrastructure.Repositories;

/// <summary>
/// eDocument Stored Procedure-ის repository implementation.
/// </summary>
public sealed class DocumentRepository : IDocumentRepository
{
    private readonly DocumentDbContext _dbContext;

    public DocumentRepository(
        DocumentDbContext dbContext)
    {
        _dbContext = dbContext;
    }

    public async Task<IReadOnlyList<UserDocumentDto>> GetUserDocumentsAsync(
        Guid userId,
        CancellationToken cancellationToken = default)
    {
        var result = new List<UserDocumentDto>();

        // DbContext-ის connection-ს ვიყენებთ პირდაპირ,
        // რადგან Stored Procedure custom result set-ს აბრუნებს.
        var connection =
            _dbContext.Database.GetDbConnection();

        // Connection თუ დახურულია, გავხსნათ.
        if (connection.State != ConnectionState.Open)
        {
            await connection.OpenAsync(cancellationToken);
        }

        await using var command =
            connection.CreateCommand();

        // Stored Procedure სახელი
        command.CommandText =
            "dbo.GetUserDocuments";

        command.CommandType =
            CommandType.StoredProcedure;

        // ============================================================
        // @UserID parameter
        // ============================================================

        var userIdParameter =
            command.CreateParameter();

        userIdParameter.ParameterName =
            "@UserID";

        userIdParameter.DbType =
            DbType.Guid;

        userIdParameter.Value =
            userId;

        command.Parameters.Add(
            userIdParameter);

        // ============================================================
        // Procedure Execute
        // ============================================================

        await using var reader =
            await command.ExecuteReaderAsync(
                cancellationToken);

        // ============================================================
        // Result Mapping
        // ============================================================

        while (await reader.ReadAsync(cancellationToken))
        {
            var item = new UserDocumentDto
            {
                DocumentID =
                    GetGuid(reader, "DocumentID")
                    ?? Guid.Empty,

                DocumentNumber =
                    GetString(reader, "DocumentNumber"),

                DocumentTypeID =
                    GetGuid(reader, "DocumentTypeID"),

                ClientID =
                    GetGuid(reader, "ClientID"),

                CreatorFullName =
                    GetString(reader, "CreatorFullName"),

                BaseDocumentNumber =
                    GetString(reader, "BaseDocumentNumber"),

                Contents =
                    GetString(reader, "Contents"),

                PhoneNumber =
                    GetString(reader, "PhoneNumber"),

                BranchName =
                    GetString(reader, "BranchName"),

                Notes =
                    GetString(reader, "Notes"),

                IsSentText =
                    GetString(reader, "IsSentText"),

                CreateDate =
                    GetDateTime(reader, "CreateDate"),

                RegistrationDate =
                    GetDateTime(reader, "RegistrationDate"),

                SenderFullName =
                    GetString(reader, "SenderFullName"),

                IsReadText =
                    GetString(reader, "IsReadText"),

                LastMovementTypeID =
                    GetGuid(reader, "LastMovementTypeID"),

                LastMovementDate =
                    GetDateTime(reader, "LastMovementDate"),

                LastMovementComment =
                    GetString(reader, "LastMovementComment"),

                HasAttachmentText =
                    GetString(reader, "HasAttachmentText")
            };

            result.Add(item);
        }

        return result;
    }

    // ==============================================================
    // Helper Methods
    // ==============================================================

    private static string? GetString(
        IDataRecord reader,
        string columnName)
    {
        var ordinal =
            reader.GetOrdinal(columnName);

        if (reader.IsDBNull(ordinal))
        {
            return null;
        }

        return reader.GetValue(ordinal)?.ToString();
    }

    private static Guid? GetGuid(
        IDataRecord reader,
        string columnName)
    {
        var ordinal =
            reader.GetOrdinal(columnName);

        if (reader.IsDBNull(ordinal))
        {
            return null;
        }

        var value =
            reader.GetValue(ordinal);

        // თუ SQL uniqueidentifier-ია,
        // ჩვეულებრივ პირდაპირ Guid დაბრუნდება.
        if (value is Guid guid)
        {
            return guid;
        }

        // fallback
        if (Guid.TryParse(
                value.ToString(),
                out var parsed))
        {
            return parsed;
        }

        return null;
    }

    private static DateTime? GetDateTime(
        IDataRecord reader,
        string columnName)
    {
        var ordinal =
            reader.GetOrdinal(columnName);

        if (reader.IsDBNull(ordinal))
        {
            return null;
        }

        var value =
            reader.GetValue(ordinal);

        if (value is DateTime dateTime)
        {
            return dateTime;
        }

        return null;
    }
}
