namespace eMembership.Application.Abstractions;

public interface IPasswordVerifier
{
    bool Verify(
        string plainPassword,
        string userName,
        string passwordHash);
}

using System.Security.Cryptography;
using System.Text;
using eMembership.Application.Abstractions;

namespace eMembership.Infrastructure.Authentication;

public sealed class LegacyMd5PasswordVerifier : IPasswordVerifier
{
    public bool Verify(
        string plainPassword,
        string userName,
        string passwordHash)
    {
        // ძველი სისტემის ლოგიკა:
        // MD5(password + user.UserName)
        var valueToHash = plainPassword + userName;

        // თავდაპირველად ვცდით UTF8-ს
        var bytes = Encoding.UTF8.GetBytes(valueToHash);

        var hashBytes = MD5.HashData(bytes);

        var calculatedHash = Convert
            .ToHexString(hashBytes)
            .ToLowerInvariant();

        // დროებითი debug
        Console.WriteLine("--------------------------------");
        Console.WriteLine($"UserName        : {userName}");
        Console.WriteLine($"DB Hash         : {passwordHash}");
        Console.WriteLine($"Calculated Hash : {calculatedHash}");
        Console.WriteLine("--------------------------------");

        return string.Equals(
            calculatedHash,
            passwordHash.Trim(),
            StringComparison.OrdinalIgnoreCase);
    }
}


using eMembership.Application.Abstractions;

namespace eMembership.Application.Auth;

public sealed class LoginService
{
    private readonly IUserRepository _userRepository;
    private readonly IPasswordVerifier _passwordVerifier;
    private readonly IJwtTokenService _jwtTokenService;

    public LoginService(
        IUserRepository userRepository,
        IPasswordVerifier passwordVerifier,
        IJwtTokenService jwtTokenService)
    {
        _userRepository = userRepository;
        _passwordVerifier = passwordVerifier;
        _jwtTokenService = jwtTokenService;
    }

    public async Task<LoginResponse?> LoginAsync(
        LoginRequest request,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(request.UserName))
        {
            return null;
        }

        if (string.IsNullOrEmpty(request.Password))
        {
            return null;
        }

        var userName = request.UserName.Trim();

        var user = await _userRepository.GetByUserNameAsync(
            userName,
            cancellationToken);

        if (user is null)
        {
            return null;
        }

        if (!user.IsActive)
        {
            return null;
        }

        // ძველი სისტემა აკეთებს:
        //
        // MD5(password + user.UserName)
        //
        // ამიტომ verifier-ს UserName-იც გადავეცით.
        var passwordIsValid =
            _passwordVerifier.Verify(
                request.Password,
                user.UserName,
                user.Password);

        if (!passwordIsValid)
        {
            return null;
        }

        var token = _jwtTokenService.GenerateToken(user);

        return new LoginResponse(
            UserId: user.ID,
            UserName: user.UserName,
            FullName: user.FullName,
            Token: token);
    }
}
