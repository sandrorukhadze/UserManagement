USE [eMembership];
GO

SELECT TOP (100)
    u.ID AS UserID,
    u.UserName,
    u.FullName,
    ua.ID AS AppointmentID,
    ua.PositionID,
    ua.BeginDate,
    ua.FinishDate
FROM users.Users AS u
INNER JOIN orgs.UserAppointments AS ua
    ON ua.UserID = u.ID
WHERE ua.IsActive = 1
ORDER BY u.UserName, ua.BeginDate DESC;


SELECT
    s.name AS SchemaName,
    t.name AS TableName,
    c.name AS ColumnName
FROM sys.tables AS t
INNER JOIN sys.schemas AS s
    ON s.schema_id = t.schema_id
INNER JOIN sys.columns AS c
    ON c.object_id = t.object_id
WHERE
    s.name = 'orgs'
    AND t.name LIKE '%Position%'
ORDER BY t.name, c.column_id;
