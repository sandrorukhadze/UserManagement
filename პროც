# eDocument - User Documents API
## Stored Procedure + Repository + JWT UserID

ამ ნაწილში ვამატებთ endpoint-ს:

```http
GET /api/documents/my
```

რომელიც ამოიღებს მიმდინარე login user-ის `UserID`-ს JWT-დან და გამოიძახებს Stored Procedure-ს `eDocument` ბაზაში.

---

# 1. SQL Stored Procedure

გაუშვი SQL Server-ში:

```sql
USE [eDocument];
GO

CREATE OR ALTER PROCEDURE dbo.GetUserDocuments
    @UserID UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;

    SELECT TOP (100)

        -- დოკუმენტის ID აუცილებლად გვჭირდება API-ში
        d.ID AS DocumentID,

        d.DocumentNumber AS DocumentNumber,
        d.DocumentTypeID AS DocumentTypeID,
        cid.ClientID AS ClientID,
        creator.FullName AS CreatorFullName,
        baseDoc.DocumentNumber AS BaseDocumentNumber,
        dd.Contents AS Contents,

        dd.PhoneNumber AS PhoneNumber,
        dd.BranchName AS BranchName,
        d.Notes AS Notes,

        CASE d.IsSent
            WHEN 1 THEN N'კი'
            WHEN 0 THEN N'არა'
            ELSE N'უცნობია'
        END AS IsSentText,

        d.CreateDate AS CreateDate,

        received.RegistrationDate AS RegistrationDate,

        sender.FullName AS SenderFullName,

        CASE received.IsReaded
            WHEN 1 THEN N'კი'
            WHEN 0 THEN N'არა'
            ELSE N'უცნობია'
        END AS IsReadText,

        lastMovement.MovementTypeID AS LastMovementTypeID,
        lastMovement.CreateDate AS LastMovementDate,
        lastMovement.Comment AS LastMovementComment,

        CASE
            WHEN EXISTS (
                SELECT 1
                FROM dbo.DocumentElVersions AS ev
                WHERE ev.DocumentID = d.ID
                  AND ev.IsActive = 1
            )
            THEN N'კი'
            ELSE N'არა'
        END AS HasAttachmentText

    FROM dbo.Documents AS d

    -- ============================================================
    -- მიმდინარე user-სთან ბოლო აქტიური / გაუუქმებელი movement
    -- ============================================================
    CROSS APPLY (
        SELECT TOP (1)
            m.RegistrationDate,
            m.FromID,
            m.IsReaded

        FROM dbo.Movements AS m

        INNER JOIN eMembership.orgs.UserAppointments AS ua
            ON ua.ID = m.ToID

        WHERE m.ThingID = d.ID

          -- ეს არის procedure-ის input parameter
          AND ua.UserID = @UserID

          -- მხოლოდ აქტიური appointment
          AND ua.IsActive = 1

          -- appointment უკვე დაწყებული უნდა იყოს
          AND ua.BeginDate <= CONVERT(date, GETDATE())

          -- და დასრულებული არ უნდა იყოს
          AND (
                ua.FinishDate IS NULL
                OR ua.FinishDate >= CONVERT(date, GETDATE())
              )

          -- მხოლოდ აქტიური movement
          AND m.IsActive = 1

          -- გაუქმებული movement არ გვინდა
          AND m.Canceled = 0

        ORDER BY
            m.CreateDate DESC,
            m.ID DESC

    ) AS received

    -- ============================================================
    -- დოკუმენტის ბოლო აქტიური movement ყველა მიმღებს შორის
    -- ============================================================
    OUTER APPLY (
        SELECT TOP (1)
            m.MovementTypeID,
            m.CreateDate,
            m.Comment

        FROM dbo.Movements AS m

        WHERE m.ThingID = d.ID
          AND m.IsActive = 1

        ORDER BY
            m.CreateDate DESC,
            m.ID DESC

    ) AS lastMovement

    -- ============================================================
    -- Document Details
    -- ============================================================
    LEFT JOIN dbo.DocumentDetails AS dd
        ON dd.ID = d.ID

    -- ============================================================
    -- Base Document
    -- ============================================================
    LEFT JOIN dbo.Documents AS baseDoc
        ON baseDoc.ID = d.BaseDocumentID

    -- ============================================================
    -- Creator
    -- ============================================================
    LEFT JOIN eMembership.users.Users AS creator
        ON creator.ID = d.CreatedBy

    -- ============================================================
    -- Client
    -- ============================================================
    LEFT JOIN dbo.ClientsInDocuments AS cid
        ON cid.DocumentID = d.ID
       AND cid.IsActive = 1

    -- ============================================================
    -- Sender appointment
    -- ============================================================
    LEFT JOIN eMembership.orgs.UserAppointments AS senderAppointment
        ON senderAppointment.ID = received.FromID

    -- ============================================================
    -- Sender user
    -- ============================================================
    LEFT JOIN eMembership.users.Users AS sender
        ON sender.ID = senderAppointment.UserID

    WHERE d.IsActive = 1

    ORDER BY
        d.CreateDate DESC,
        d.ID;
END;
GO
```

